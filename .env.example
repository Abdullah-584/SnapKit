# SnapKit environment variables (all optional).
# Copy to `.env.local` for development; set the same names in your host's
# environment/CI settings for production builds. Never commit real secrets —
# these are public build-time values, not secrets.

# Canonical site origin used for canonical URLs, Open Graph and the sitemap.
# Keep this on the deployed domain; change it only when migrating domains.
VITE_SITE_URL=https://snapkit.42web.io

# Contact address shown on /contact/. Leave empty to show the honest
# "contact channel not configured" state instead of inventing an address.
# Example: VITE_CONTACT_EMAIL=hello@yourdomain.com
VITE_CONTACT_EMAIL=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX).
# Ads stay completely disabled (no script, no requests, no markup) until this
# is set AND the visitor grants advertising consent. Do not set a fabricated ID.
VITE_ADSENSE_CLIENT=
